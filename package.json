{
  "name": "rts-match-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser single-player 1v1v1 strategy match prototype",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/build-info.mjs --write",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:flow && npm run build",
    "test:flow": "node --test scripts/checkpoint-sync.test.mjs",
    "selfplay": "node scripts/run-selfplay.mjs",
    "references:check": "node scripts/check-references.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "prettier": "3.8.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
